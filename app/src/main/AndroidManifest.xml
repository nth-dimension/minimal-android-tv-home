<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Read other apps' "Continue watching" (Watch Next) rows. Runtime permission. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <!-- Recently used apps. Granted over ADB with appops. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- A launcher must see every installed app. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Poster images from Watch Next rows, and optional Unsplash photos. Some apps still
         publish plain-http poster URLs, hence usesCleartextTraffic below. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Sleep timer: turn the TV off on time. Android 12 grants the first at install; 13+ the second. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Android 13+ hides a background app's toasts without this; the timer's 1-minute warning is one. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MinimalHome"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:priority="2">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Sees which video apps are playing, for Up Next. Reads media sessions, not notifications. -->
        <service
            android:name=".data.MediaListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Screensaver: Unsplash photos. scripts/install.sh makes it the TV's screensaver. -->
        <service
            android:name=".screensaver.PhotoDream"
            android:exported="true"
            android:label="Unsplash photos"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <activity
            android:name=".screensaver.ScreensaverPreviewActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MinimalHome"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- Sleep timer alarms. -->
        <receiver android:name=".data.SleepTimerReceiver" android:exported="false" />

        <!-- adb-only commands (shell holds DUMP; apps don't): set or cancel a timer, drop the admin. -->
        <receiver
            android:name=".data.SleepTimerCommands"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.minimal.tvhome.SLEEP_TIMER_SET" />
                <action android:name="dev.minimal.tvhome.SLEEP_TIMER_CANCEL" />
                <action android:name="dev.minimal.tvhome.REMOVE_ADMIN" />
            </intent-filter>
        </receiver>

        <!-- Lets the sleep timer put the TV into standby. Turned on by scripts/install.sh. -->
        <receiver
            android:name=".data.SleepAdmin"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/sleep_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
